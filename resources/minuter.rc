 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", L"Minuter standalone time cues\0"
   VALUE "ProductName", L"Minuter\0"
   VALUE "ProductVersion", L"0.2.0\0"
   VALUE "OriginalFilename", L"Minuter.exe\0"
   VALUE "Comments", L"Based on Minuter by Andre Louis. Rust port with rungui and Prismer.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
